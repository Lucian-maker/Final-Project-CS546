<main class="page">
	<h1>Violation Detail</h1>

	<p>
		<strong>Address:</strong>
		{{violation.buildingAddress}}
	</p>

	<p><strong>Violation ID:</strong> {{violation._id}}</p>

	<p><strong>Type:</strong> {{violation.violationType}}</p>
	<p><strong>Status:</strong> {{violation.violationStatus}}</p>

	<p><strong>Description:</strong> {{violation.violationDescription}}</p>

	<p><strong>Property ID:</strong> {{violation.propertyId}}</p>

	{{#if user}}
		{{#if (eq user.userRole "admin")}}
			<section>
				<h2>Update Status</h2>

				<form class="field" method="POST" action="/violations/{{violation._id}}/status">
					<div class="field">
						<label>Status</label>
						<select name="status">
							<option value="Open">Open</option>
							<option value="Repair Scheduled">Repair Scheduled</option>
							<option value="Resolved">Resolved</option>
						</select>
					</div>

					<button type="submit">Update Status</button>
				</form>
			</section>
		{{/if}}
	{{/if}}

	<section class="site-footer">
		<a href="/violations">Back to Violations</a>
	</section>
</main>
