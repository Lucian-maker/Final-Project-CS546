<main class="page violation-detail">
	<h1>Violation detail</h1>
	<p><a href="/violations">Back to violations</a></p>

	{{#if statusMessage}}
		<p class="success-banner">{{statusMessage}}</p>
	{{/if}}
	{{#if error}}
		<p class="error">{{error}}</p>
	{{/if}}

	<section class="violation-summary">
		<h2>{{violation.buildingAddress}}</h2>
		<dl class="detail-grid">
			<dt>Violation ID</dt>
			<dd><code>{{violation._id}}</code></dd>
			<dt>Property ID</dt>
			<dd>
				<a href="/properties/{{violation.propertyId}}">{{violation.propertyId}}</a>
			</dd>
			<dt>Borough</dt>
			<dd>{{violation.borough}}</dd>
			<dt>Type</dt>
			<dd>{{violation.violationType}}</dd>
			<dt>Class</dt>
			<dd>{{violation.violationClass}}</dd>
			<dt>Status</dt>
			<dd>{{violation.violationStatus}}</dd>
			<dt>Description</dt>
			<dd>{{violation.violationDescription}}</dd>
			<dt>Certify by</dt>
			<dd>{{violation.originalCertifyByDateFormatted}}</dd>
			<dt>Days remaining</dt>
			<dd>{{violation.daysRemaining}}</dd>
			<dt>Actionable</dt>
			<dd>{{violation.isActionable}}</dd>
			<dt>Inspection</dt>
			<dd>{{violation.inspectionDateFormatted}}</dd>
			<dt>Repair scheduled</dt>
			<dd>{{violation.repairScheduledAtFormatted}}</dd>
			<dt>Resolved</dt>
			<dd>{{violation.resolvedAtFormatted}}</dd>
			<dt>Source</dt>
			<dd>{{violation.source}}</dd>
		</dl>
	</section>

	<section class="violation-remediation">
		<h2>Remediation</h2>
		<p><strong>Current state:</strong> {{violation.remediationStatus.currentState}}</p>
		<p><strong>Notes:</strong> {{violation.remediationStatus.notes}}</p>
		<p><strong>Updated:</strong> {{violation.remediationUpdatedAtFormatted}}</p>
	</section>

	<section class="violation-history">
		<h2>Status history</h2>
		{{#if violation.statusHistory.length}}
			<ul class="history-list">
				{{#each violation.statusHistory}}
					<li>
						<strong>{{this.state}}</strong>
						— {{this.changedAtFormatted}}
						<span class="muted">({{this.changedBy}})</span>
					</li>
				{{/each}}
			</ul>
		{{else}}
			<p>No history entries.</p>
		{{/if}}
	</section>

	<p class="actions-row">
		<a class="button-link" href="/evidence?violationId={{violation._id}}">Evidence for this violation</a>
	</p>

	{{#if allowedNextStatuses.length}}
		<section class="status-update">
			<h2>Update status</h2>
			<form method="POST" action="/violations/{{violation._id}}">
				<div class="field">
					<label for="newStatus">New status</label>
					<select id="newStatus" name="newStatus" required>
						{{#each allowedNextStatuses}}
							<option value="{{this}}">{{this}}</option>
						{{/each}}
					</select>
				</div>
				<div class="field">
					<label for="notes">Notes</label>
					<textarea id="notes" name="notes" rows="3" maxlength="2000" placeholder="Describe this update"></textarea>
				</div>
				<button type="submit">Submit update</button>
			</form>
		</section>
	{{else}}
		<p class="muted">No status transitions are available for your role from the current state.</p>
	{{/if}}
</main>
