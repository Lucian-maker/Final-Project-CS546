<main class="page evidence-page">
	
	<div class="dashboard-header">
		<h1>Evidence Vault</h1>
		<p class="dashboard-subtitle">
			Review, filter, and upload violation evidence records.
		</p>
	</div>

	<nav class="page-back-nav">
		{{#if violationId}}
			<a href="/violations/{{violationId}}?from={{from}}&propertyId={{propertyId}}">
				Back to Violation
			</a>

		{{else if propertyId}}
			<a href="/properties/{{propertyId}}?from={{from}}">
				Back to Property
			</a>

		{{else if (eq from "tenant")}}
			<a href="/tenant">Back to Tenant Dashboard</a>

		{{else if (eq from "landlord")}}
			<a href="/landlord">Back to Landlord Dashboard</a>

		{{else if (eq from "admin")}}
			<a href="/admin">Back to Admin Controls</a>

		{{else}}
			<a href="/dashboard">Back to Dashboard</a>
		{{/if}}
	</nav>

	<section>
		<h2>Filter Evidence</h2>

		<form method="GET" action="/evidence" class="filters-form">
			<div class="filters-grid">
				<div class="field">
					<label for="violationIdFilter">Violation ID</label>
					<input
						type="text"
						id="violationIdFilter"
						name="violationId"
						value="{{filters.violationId}}"
						placeholder="viol-..."
					/>
				</div>

				<div class="field">
					<label for="propertyIdFilter">Property ID</label>
					<input
						type="text"
						id="propertyIdFilter"
						name="propertyId"
						value="{{filters.propertyId}}"
						placeholder="prop-..."
					/>
				</div>

				<div class="field">
					<label for="evidenceType">Evidence Type</label>
					<select id="evidenceType" name="evidenceType">
						<option value="">Any</option>
						<option value="photo" {{#if (eq filters.evidenceType "photo")}}selected{{/if}}>Photo</option>
						<option value="note" {{#if (eq filters.evidenceType "note")}}selected{{/if}}>Note</option>
					</select>
				</div>

				<div class="field">
					<label for="q">Search Notes / Captions</label>
					<input
						type="text"
						id="q"
						name="q"
						value="{{filters.q}}"
						placeholder="Keywords..."
					/>
				</div>
			</div>

			<div class="actions-row">

				<button type="submit">
					Apply Filters
				</button>

				<a
					class="button-link"
					href="/evidence{{#if from}}?from={{from}}{{/if}}"
					style="
						background:#e2e8f0;
						color:#0f172a !important;
						border:1px solid #cbd5e1;
					"
				>
					Clear Filters
				</a>

			</div>
			
		</form>
	</section>

	<section class="evidence-add">
		<h2>Add evidence</h2>
		<p class="muted">
			Add a text note, optionally attach an image, and use the caption and/or note fields as needed. An image must include at least a caption or note; text-only entries require note text.
		</p>
		<form method="POST" action="/evidence" class="evidence-form" id="evidence-form">
			<input type="hidden" name="from" value="{{from}}" />
			<input type="hidden" name="propertyId" value="{{propertyId}}" />
			<div class="field">
				<label for="violationId">Violation ID</label>
				<input type="text" id="violationId" name="violationId" value="{{violationId}}" required placeholder="viol-..." />
			</div>
			<div class="field" id="field-evidence-image">
				<label for="evidenceFile">Image file</label>
				<input type="file" id="evidenceFile" accept="image/jpeg,image/png,image/gif,image/webp" />
				<input type="hidden" name="imageData" id="imageData" value="" autocomplete="off" />
				<input type="hidden" name="originalFileName" id="originalFileName" value="" autocomplete="off" />
			</div>
			<div class="field">
				<label for="caption">Caption (short)</label>
				<input type="text" id="caption" name="caption" maxlength="500" placeholder="Optional; useful with an image" />
			</div>
			<div class="field" id="field-note-text">
				<label for="noteText">Note text</label>
				<textarea id="noteText" name="noteText" rows="4" maxlength="2000" placeholder="Required for text-only; with an image, add note and/or caption"></textarea>
			</div>
			<button type="submit">Save evidence</button>
		</form>
	</section>

	<section class="evidence-list">
		<h2>Recorded evidence ({{evidenceRows.length}})</h2>
		{{#if evidenceRows.length}}
			<ul class="evidence-cards">
				{{#each evidenceRows}}
					<li class="evidence-card">
						<header>
							<strong>{{this.evidenceType}}</strong>
							<span class="muted">{{this.uploadedAtFormatted}}</span>
						</header>
						{{#if this.fileUrl}}
							<p><a href="{{this.fileUrl}}" target="_blank" rel="noopener noreferrer">{{this.fileName}}</a></p>
							{{#if (evidenceShowImage this.fileUrl this.mimeType)}}
								<img src="{{this.fileUrl}}" alt="" class="evidence-thumb" referrerpolicy="no-referrer" />
							{{/if}}
						{{/if}}
						{{#if this.caption}}
							<p><em>{{this.caption}}</em></p>
						{{/if}}
						{{#if this.noteText}}
							<p>{{this.noteText}}</p>
						{{/if}}
						<p class="muted">
							Violation:
							<a href="/violations/{{this.violationId}}?from={{../from}}&propertyId={{this.propertyId}}">{{this.violationId}}</a>
							· Property:
							<a href="/properties/{{this.propertyId}}?from={{../from}}">{{this.propertyId}}</a>
						</p>
						{{#if (eq ../user.userRole "admin")}}
							<form method="POST" action="/evidence/{{this._id}}/delete" class="inline-form">
								{{#if ../violationId}}
									<input type="hidden" name="violationId" value="{{../violationId}}" />
								{{/if}}

								{{#if ../propertyId}}
									<input type="hidden" name="propertyId" value="{{../propertyId}}" />
								{{/if}}

								<input type="hidden" name="from" value="{{../from}}" />

								<button type="submit" class="btn-danger">
									Delete entry
								</button>
							</form>

						{{else if (eq ../user._id this.uploadedByUserId)}}
							<form method="POST" action="/evidence/{{this._id}}/delete" class="inline-form">
								{{#if ../violationId}}
									<input type="hidden" name="violationId" value="{{../violationId}}" />
								{{/if}}

								{{#if ../propertyId}}
									<input type="hidden" name="propertyId" value="{{../propertyId}}" />
								{{/if}}

								<input type="hidden" name="from" value="{{../from}}" />

								<button type="submit" class="btn-danger">
									Delete my entry
								</button>
							</form>
						{{/if}}
					</li>
				{{/each}}
			</ul>
		{{else}}
			<p>No evidence yet.</p>
		{{/if}}
	</section>

	<script>
		(function () {
			var form = document.getElementById("evidence-form");
			var evidenceFile = document.getElementById("evidenceFile");
			var imageData = document.getElementById("imageData");
			var originalFileName = document.getElementById("originalFileName");
			if (form && evidenceFile) {
				form.addEventListener("submit", function (e) {
					if (!evidenceFile.files || !evidenceFile.files[0]) {
						if (imageData) imageData.value = "";
						if (originalFileName) originalFileName.value = "";
						return;
					}
					e.preventDefault();
					var fr = new FileReader();
					fr.onerror = function () {
						alert("Could not read the image file.");
					};
					fr.onload = function () {
						if (imageData) imageData.value = fr.result;
						if (originalFileName)
							originalFileName.value = evidenceFile.files[0].name;
						form.submit();
					};
					fr.readAsDataURL(evidenceFile.files[0]);
				});
			}
		})();
	</script>
</main>
