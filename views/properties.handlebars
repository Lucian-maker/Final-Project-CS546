<main class="page">
	<h1>Properties</h1>

	<section>
		<h2>Search Properties</h2>

		<form class="field" method="GET" action="/properties">
			<div class="field">
				<input
					type="text"
					name="search"
					placeholder="Search by address..."
					value="{{search}}"
				/>
			</div>
			<button type="submit">Search</button>
		</form>
	</section>

	<section>
		<h2>All Properties</h2>

		{{#if propertiesList.length}}
			<table>
				<thead>
					<tr>
						<th>Address</th>
						<th># Violations</th>
						<th># Reviews</th>
					</tr>
				</thead>

				<tbody>
					{{#each propertiesList}}
						<tr>
							<td>
								<a href="/properties/{{this._id}}">
									{{this.address.number}} {{this.address.street}},
									{{this.address.city}},
									{{this.address.state}} {{this.address.zipCode}}
								</a>
							</td>
							<td>{{this.violations.length}}</td>
							<td>{{this.reviews.length}}</td>
						</tr>
					{{/each}}
				</tbody>
			</table>
		{{else}}
			<p>No properties found.</p>
		{{/if}}
	</section>

	<section class="site-footer">
		<a href="/dashboard">Back to Dashboard</a>
	</section>
</main>
