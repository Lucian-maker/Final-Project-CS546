<main class="page">
	<div class="dashboard-header">
		<h1>Notifications</h1>
		<p class="dashboard-subtitle">
			View alerts and reminders.
		</p>
	</div>

	<nav class="page-back-nav">
		<a href="/dashboard">
			Back to Dashboard
		</a>
	</nav>
	{{#if notifications}}
		<ul class="card-grid">
			{{#each notifications}}
				<li class="card">
					<span class="badge badge-warning">{{this.channel}} - {{this.status}}</span>
					<p>{{this.notificationDetails.text}}</p>
					<p style="margin-top: auto; padding-top: 1rem;"><small style="color: #64748b;">{{this.createdAt}}</small></p>
				</li>
			{{/each}}
		</ul>
	{{else}}
		<p>No new notifications.</p>
	{{/if}}
</main>
