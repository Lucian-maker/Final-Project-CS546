<main class="page" id="notifications-page">

	<div class="dashboard-header dashboard-header-row">
		<div>
			<h1>Notifications</h1>
			<p class="dashboard-subtitle">
				View system alerts, violation updates, and important activity tied to your account.
			</p>
		</div>

		<button
			type="button"
			id="js-notif-mark-all"
			class="btn-notif-clear notif-clear-form"
			{{#unless hasQueued}}hidden{{/unless}}
		>
			Mark all read
		</button>
	</div>

	<nav class="page-back-nav">
		<a href="/dashboard">
			Back to Dashboard
		</a>
	</nav>

	{{#if notifications.length}}
		<div id="notification-card-list" class="card-grid">

			{{#each notifications}}
				<div
					class="card notif-card"
					data-notification-id="{{this.stringId}}"
				>

					<div class="dashboard-header dashboard-header-row">
						<h3 class="card-title">
							Notification
						</h3>

						<span class="badge badge-warning">
							{{this.channel}} · {{this.status}}
						</span>
					</div>

					<p>
						{{this.notificationDetails.text}}
					</p>

					<div class="detail-grid">

						<div>
							<strong>Violation</strong>
							<p>
								<a href="/violations/{{this.violationId}}">
									Violation {{this.violationId}}
								</a>
							</p>
						</div>

						<div>
							<strong>Received</strong>
							<p>{{this.createdAt}}</p>
						</div>

					</div>

					{{#if (eq this.status "queued")}}
						<div class="actions-row">
							<button
								type="button"
								class="btn-notif-dismiss js-notif-mark-one"
								data-notification-id="{{this.stringId}}"
							>
								Mark read
							</button>
						</div>
					{{/if}}

				</div>
			{{/each}}

		</div>
	{{else}}
		<div id="notification-card-list" class="card-grid"></div>
	{{/if}}

	<p id="notifications-empty-msg" {{#if notifications.length}}hidden{{/if}}>
		No notifications yet.
	</p>

	<p id="notifications-error-msg" class="error" hidden></p>

	<script src="/public/js/notifications_page.js" defer></script>

</main>
