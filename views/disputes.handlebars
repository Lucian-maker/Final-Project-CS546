<main class="page">
	<div class="dashboard-header">
		<h1>Disputes</h1>
		<p class="dashboard-subtitle">
			Track and manage active housing disputes.
		</p>
	</div>
	<nav class="page-back-nav">
		<a href="/dashboard">
			Back to Dashboard
		</a>
	</nav>
	{{#if disputes}}
		<ul class="card-grid">
			{{#each disputes}}
				<li class="card">
					<span class="badge badge-info">{{this.status}}</span>
					<h2 class="card-title">{{this.eventType}}</h2>
					<p><strong>Result:</strong> {{this.result}}</p>
					<p><strong>Created At:</strong> <small>{{this.createdAtFormatted}}</small></p>
					<a href="/disputes/{{this._id}}">View Details</a>
				</li>
			{{/each}}
		</ul>
	{{else}}
		<p>No active disputes.</p>
	{{/if}}
</main>
