<main class="page">
	<h1>Disputes</h1>
	{{#if disputes}}
		<ul class="card-grid">
			{{#each disputes}}
				<li class="card">
					<span class="badge badge-info">{{this.status}}</span>
					<h2 class="card-title">{{this.eventType}}</h2>
					<p><strong>Result:</strong> {{this.result}}</p>
					<p><strong>Created At:</strong> <small>{{this.createdAtFormatted}}</small></p>
					<a href="/disputes/{{this._id}}">View Details</a>
				</li>
			{{/each}}
		</ul>
	{{else}}
		<p>No active disputes.</p>
	{{/if}}
	<a href="/dashboard">Back to Dashboard</a>
</main>
