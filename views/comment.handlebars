<main class="page comment-detail">
	<h1>Comment detail</h1>
	<p>
		<a href="/comments/{{comment.propertyId}}">Back to thread</a>
		·
		<a href="/comments">All comments</a>
	</p>

	{{#if error}}
		<p class="error">{{error}}</p>
	{{/if}}

	<section class="comment-summary">
		<h2><span class="badge badge-info">{{comment.authorRole}}</span> · {{buildingAddress}}</h2>
		<dl class="detail-grid">
			<dt>Comment ID</dt>
			<dd><code>{{comment._id}}</code></dd>
			<dt>Property</dt>
			<dd><a href="/properties/{{comment.propertyId}}">{{buildingAddress}}</a></dd>
			<dt>Author</dt>
			<dd>
				{{#if author}}
					{{author.firstName}} {{author.lastName}} ({{author.userRole}})
				{{else}}
					<code>{{comment.authorId}}</code>
				{{/if}}
			</dd>
			<dt>Posted</dt>
			<dd>{{comment.createdAtFormatted}}</dd>
			{{#if comment.wasEdited}}
				<dt>Last edited</dt>
				<dd>{{comment.updatedAtFormatted}}</dd>
			{{/if}}
		</dl>
	</section>

	<section class="comment-body">
		<h2>Comment</h2>
		<blockquote>{{comment.commentText}}</blockquote>
	</section>

	<p class="actions-row">
		<a class="button-link" href="/properties/{{comment.propertyId}}">Open property</a>
		<a class="button-link" href="/comments/{{comment.propertyId}}">Open thread</a>
	</p>

	{{#if isOwn}}
		<section class="status-update">
			<h2>Manage your comment</h2>
			<details class="comment-edit-toggle">
				<summary>Edit</summary>
				<form method="POST" action="/comments/{{comment._id}}/edit" novalidate>
					<div class="field">
						<label for="commentText-edit">Comment</label>
						<textarea id="commentText-edit" name="commentText" rows="4" maxlength="1000" required>{{comment.commentText}}</textarea>
					</div>
					<button type="submit">Save</button>
				</form>
			</details>
			<form class="inline-form" method="POST" action="/comments/{{comment._id}}/delete">
				<button type="submit" class="btn-danger">Delete</button>
			</form>
		</section>
	{{/if}}
</main>
