<main class="page">
	<div class="dashboard-header">
		<h1>Manage Profile</h1>

		<p class="dashboard-subtitle">
			Update your account and secondary contact information.
		</p>
	</div>

	<nav class="page-back-nav">
		<a href="{{backTo}}">Back</a>
	</nav>

	{{#if success}}
		<p class="success-banner">{{success}}</p>
	{{/if}}

	{{#if error}}
		<p class="error">{{error}}</p>
	{{/if}}

	<section class="card">
		<h2>Edit Profile</h2>

		<form method="POST" action="/profile?from={{from}}">
			<input type="hidden" name="from" value="{{from}}" />

			<div class="field">
				<label for="firstName">First Name</label>
				<input id="firstName" name="firstName" value="{{user.firstName}}" required />
			</div>

			<div class="field">
				<label for="lastName">Last Name</label>
				<input id="lastName" name="lastName" value="{{user.lastName}}" required />
			</div>

			<div class="field">
				<label for="email">Email</label>
				<input id="email" name="email" value="{{user.email}}" required />
			</div>

			<div class="field">
				<label for="phoneNumber">Phone Number</label>
				<input id="phoneNumber" name="phoneNumber" value="{{user.phoneNumber}}" required />
			</div>

			<h2>Secondary Contact</h2>

			<div class="field">
				<label for="secondaryContactName">Name</label>
				<input
					id="secondaryContactName"
					name="secondaryContactName"
					value="{{user.secondaryContact.name}}"
					placeholder="Optional"
				/>
			</div>

			<div class="field">
				<label for="secondaryContactEmail">Email</label>
				<input
					id="secondaryContactEmail"
					name="secondaryContactEmail"
					value="{{user.secondaryContact.email}}"
					placeholder="Optional"
				/>
			</div>

			<div class="field">
				<label for="secondaryContactPhone">Phone Number</label>
				<input
					id="secondaryContactPhone"
					name="secondaryContactPhone"
					value="{{user.secondaryContact.phoneNumber}}"
					placeholder="Optional"
				/>
			</div>

			<button type="submit">
				Update Profile
			</button>
		</form>
	</section>
</main>
