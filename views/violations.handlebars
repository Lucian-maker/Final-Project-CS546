<main class="page">

	<div class="dashboard-header">
		<h1>Violations</h1>

		<p class="dashboard-subtitle">
			Browse and search violations.
		</p>
	</div>

	{{#if (eq user.userRole "admin")}}
	<section class="card">
		<h2>Create Violation</h2>

		<form method="POST" action="/violations/create">

			<div class="field">
				<label>Property ID</label>
				<input name="propertyId" required />
			</div>

			<div class="field">
				<label>Violation Type</label>
				<input name="violationType" required />
			</div>

			<div class="field">
				<label>Description</label>
				<input name="violationDescription" required />
			</div>

			<button type="submit">Create Violation</button>
		</form>
	</section>
	{{/if}}

	<section>

		<h2>Search Violations</h2>

		<div class="dashboard-search">
			<form class="search-form" method="GET" action="/violations">

				<input
					type="text"
					name="search"
					placeholder="Search by address, type, status..."
					value="{{search}}"
				/>

				<button type="submit" class="btn-search">
					Search
				</button>

			</form>
		</div>

		<h2>All Violations</h2>

		{{#if violations.length}}

			<div class="card-grid">

				{{#each violations}}

					<div class="card">

						<h3 class="card-title">
							{{buildingAddress}}
						</h3>

						<span class="badge badge-info">
							{{violationStatus}}
						</span>

						<p><strong>Type:</strong> {{violationType}}</p>
						<p><strong>Description:</strong> {{violationDescription}}</p>

						<a href="/violations/{{_id}}">
							View Details
						</a>

					</div>

				{{/each}}

			</div>

		{{else}}
			<p>No violations found.</p>
		{{/if}}

	</section>

	<section class="site-footer">
		<a href="/dashboard">Back to Dashboard</a>
	</section>

</main>
