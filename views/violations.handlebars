<main class="page">

	<div class="dashboard-header">
		<h1>Violations</h1>

		<p class="dashboard-subtitle">
			Browse and search violations.
		</p>
	</div>

	{{#if (eq user.userRole "admin")}}
	<section class="card">
		<h2>Create Violation</h2>

		<form method="POST" action="/violations/create">

			<div class="field">
				<label>Property ID</label>
				<input name="propertyId" required />
			</div>

			<div class="field">
				<label>Violation Type</label>
				<input name="violationType" required />
			</div>

			<div class="field">
				<label>Description</label>
				<input name="violationDescription" required />
			</div>

			<button type="submit">Create Violation</button>
		</form>
	</section>
	{{/if}}

	<form method="GET" action="/violations" class="filters-form">
		<div class="filters-grid">
			<div class="field">
				<label for="q">Search address / description</label>
				<input type="text" id="q" name="q" value="{{filters.q}}" placeholder="Keywords..." />
			</div>
			<div class="field">
				<label for="borough">Borough</label>
				<select id="borough" name="borough">
					<option value="">Any</option>
					{{#each boroughs}}
					<option value="{{this}}" {{#if (eq ../filters.borough this)}}selected{{/if}}>{{this}}</option>
					{{/each}}
				</select>
			</div>
			<div class="field">
				<label for="violationType">Violation type</label>
				<input type="text" id="violationType" name="violationType" value="{{filters.violationType}}"
					placeholder="e.g. Mold" />
			</div>
			<div class="field">
				<label for="violationStatus">Status</label>
				<select id="violationStatus" name="violationStatus">
					<option value="">Any</option>
					{{#each statuses}}
					<option value="{{this}}" {{#if (eq ../filters.violationStatus this)}}selected{{/if}}>{{this}}
					</option>
					{{/each}}
				</select>
			</div>
			<div class="field">
				<label for="propertyId">Property ID</label>
				<input type="text" id="propertyId" name="propertyId" value="{{filters.propertyId}}"
					placeholder="prop-..." />
			</div>
			<div class="field">
				<label for="days">Due within (days)</label>
				<input type="number" id="days" name="days" min="0" value="{{filters.days}}" placeholder="e.g. 30" />
			</div>
			<div class="field">
				<label for="sort">Sort by</label>
				<select id="sort" name="sort">
					<option value="updatedAt" {{#if (eq filters.sort "updatedAt" )}}selected{{/if}}>Last updated
					</option>
					<option value="originalCertifyByDate" {{#if (eq filters.sort "originalCertifyByDate"
						)}}selected{{/if}}>Certify-by date</option>
					<option value="buildingAddress" {{#if (eq filters.sort "buildingAddress" )}}selected{{/if}}>Address
					</option>
				</select>
			</div>
			<div class="field">
				<label for="order">Order</label>
				<select id="order" name="order">
					<option value="desc" {{#if (eq filters.order "desc" )}}selected{{/if}}>Newest first</option>
					<option value="asc" {{#if (eq filters.order "asc" )}}selected{{/if}}>Oldest first</option>
				</select>
			</div>
		</div>
		<button type="submit">Apply filters</button>
	</form>

	<div class="quick-controls" style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center; background: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;">
		<strong style="color: #475569;">Fast Filter:</strong>
		<input type="text" id="quickFilter" placeholder="Type to filter rows instantly..." style="padding: 0.5rem; border-radius: 4px; border: 1px solid #cbd5e1; flex-grow: 1;">
		<button id="sortDateBtn" class="btn-like" style="padding: 0.5rem 1rem;">Sort by Date ↕</button>
	</div>

	{{#if violations.length}}
		<div class="card-grid" id="violationsGrid">
			{{#each violations}}
				<div class="card" data-date="{{originalCertifyByDate}}">
					<h3 class="card-title">{{buildingAddress}}</h3>
					<span class="badge badge-info">{{violationStatus}}</span>
					<p><strong>Type:</strong> {{violationType}}</p>
					<p><strong>Class:</strong> {{violationClass}}</p>
					<p><strong>Due:</strong> {{originalCertifyByDateFormatted}} ({{daysRemaining}} days left)</p>
					<p><strong>Description:</strong> {{violationDescription}}</p>
					<a href="/violations/{{_id}}">View Details</a>
				</div>
			{{/each}}
		</div>
	{{else}}
		<p>No violations found.</p>
	{{/if}}
	</section>

	<section class="site-footer">
		<a href="/dashboard">Back to Dashboard</a>
	</section>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const filterInput = document.getElementById('quickFilter');
    const cards = document.querySelectorAll('#violationsGrid .card');
    const sortBtn = document.getElementById('sortDateBtn');
    
    if (filterInput && cards.length > 0) {
        filterInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(term) ? '' : 'none';
            });
        });
    }

    if (sortBtn && cards.length > 0) {
        let sortAsc = true;
        sortBtn.addEventListener('click', () => {
            sortAsc = !sortAsc;
            const grid = document.getElementById('violationsGrid');
            const cardsArray = Array.from(cards);
            
            cardsArray.sort((a, b) => {
                const dateA = new Date(a.getAttribute('data-date'));
                const dateB = new Date(b.getAttribute('data-date'));
                if (isNaN(dateA) || isNaN(dateB)) {
                    return sortAsc ? a.innerText.localeCompare(b.innerText) 
                                   : b.innerText.localeCompare(a.innerText);
                }
                return sortAsc ? dateA - dateB : dateB - dateA;
            });
            
            cardsArray.forEach(card => grid.appendChild(card));
        });
    }
});
</script>