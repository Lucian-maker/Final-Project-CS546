<main class="page comments-page">
	<h1>Comments</h1>
	<p><a href="/dashboard">Back to Dashboard</a></p>

	<section class="comment-thread">
		<h2>All visible comments ({{comments.length}})</h2>
		{{#if comments.length}}
			{{#each comments}}
				<article class="comment-card">
					<header class="comment-card__header">
						<span class="badge badge-info">{{authorRole}}</span>
						<time>{{createdAtFormatted}}</time>
						{{#if wasEdited}}<span class="muted">(edited)</span>{{/if}}
					</header>
					<p class="comment-card__text">{{commentText}}</p>
					<footer class="comment-card__footer">
						<p>
							<strong>Property:</strong>
							<a href="/properties/{{propertyId}}">{{buildingAddress}}</a>
						</p>
						<p>
							<strong>By:</strong> {{authorName}}
							{{#if isOwn}}<span class="muted">(you)</span>{{/if}}
						</p>
						<a href="/comments/single/{{_id}}">View Details</a>
						<a href="/comments/{{propertyId}}">Open thread</a>
					</footer>
				</article>
			{{/each}}
		{{else}}
			<p>No comments to show. Visit a property page to start a thread.</p>
		{{/if}}
	</section>
</main>
