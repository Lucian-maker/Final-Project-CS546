<main class="page">
<div class="dashboard-header dashboard-header-row">
	<div>
		<h1>Dashboard</h1>
		<p class="welcome-text">
			Welcome, <strong>{{user.firstName}} {{user.lastName}}</strong> ({{user.userRole}}).
		</p>
	</div>

	{{#if isAdmin}}
		<a href="/admin" class="dashboard-tile dashboard-mini-tile admin-tile">
			<span class="tile-icon">⚙️</span>
			<span class="tile-text">Admin Controls</span>
		</a>
	{{/if}}
	{{#if (eq user.userRole "tenant")}}
			<a href="/tenant" class="dashboard-tile dashboard-mini-tile admin-tile">
				<span class="tile-icon">🏠</span>
				<span class="tile-text">
					Tenant Dashboard
				</span>
			</a>
		{{/if}}

	{{#if (eq user.userRole "landlord")}}
		<a href="/landlord" class="dashboard-tile dashboard-mini-tile admin-tile">
			<span class="tile-icon">🏘️</span>
			<span class="tile-text">
				Landlord Dashboard
			</span>
		</a>
	{{/if}}

</div>

	<h2 style="margin-bottom:0.5rem;">Active Violations</h2>

	<div class="analytics-container">
		<a href="/violations?minDays=16&days=30" class="metric-card">
			<span class="metric-value">{{violations30Days}}</span>
			<span class="metric-label">Due in 16–30 Days</span>
		</a>
		<a href="/violations?minDays=8&days=15" class="metric-card">
			<span class="metric-value metric-warning">{{violations15Days}}</span>
			<span class="metric-label">Due in 8–15 Days</span>
		</a>
		<a href="/violations?days=7" class="metric-card">
			<span class="metric-value metric-danger">{{violations7Days}}</span>
			<span class="metric-label">Due in ≤ 7 Days (Critical)</span>
		</a>
	</div>

	<h2 style="margin-bottom:0.5rem;">Explore</h2>

	<div class="dashboard-grid">
		<a href="/properties" class="dashboard-tile">
			<span class="tile-icon">🏢</span>
			<span class="tile-text">Properties</span>
		</a>
		<a href="/violations" class="dashboard-tile">
			<span class="tile-icon">⚠️</span>
			<span class="tile-text">Violations</span>
		</a>
		<a href="/evidence" class="dashboard-tile">
			<span class="tile-icon">📁</span>
			<span class="tile-text">Evidence Vault</span>
		</a>
		<a href="/notifications" class="dashboard-tile" id="dashboard-notif-tile">
			<span class="dashboard-notif-badge notif-badge" hidden aria-live="polite">0</span>
			<span class="tile-icon">🔔</span>
			<span class="tile-text">Notifications</span>
		</a>
		<a href="/disputes" class="dashboard-tile">
			<span class="tile-icon">⚖️</span>
			<span class="tile-text">Disputes</span>
		</a>
		<a href="/attorneys" class="dashboard-tile">
			<span class="tile-icon">👔</span>
			<span class="tile-text">Attorneys</span>
		</a>
	</div>

	{{#if communityInsights}}
		<section style="margin-bottom:2rem;">
			<h2 style="margin-bottom:0.5rem;">Community Insights</h2>

			<div class="card-grid">
				{{#if communityInsights.highestRated}}
				<a href="/properties/{{communityInsights.highestRated._id}}" class="card" style="text-decoration:none; color:inherit;">
					<span class="badge badge-warning">Highest Rated</span>
					<h3 class="card-title">{{communityInsights.highestRated.address}}</h3>
					<p>⭐ {{communityInsights.highestRated.displayRating}} / 5</p>
				</a>
				{{/if}}

				{{#if communityInsights.mostReviewed}}
				<a href="/properties/{{communityInsights.mostReviewed._id}}" class="card" style="text-decoration:none; color:inherit;">
					<span class="badge badge-info">Most Reviewed</span>
					<h3 class="card-title">{{communityInsights.mostReviewed.address}}</h3>
					<p>📝 {{communityInsights.mostReviewed.reviewCount}} ratings</p>
				</a>
				{{/if}}

				{{#if communityInsights.mostCommented}}
				<a href="/properties/{{communityInsights.mostCommented._id}}" class="card" style="text-decoration:none; color:inherit;">
					<span class="badge badge-success">Most Discussed</span>
					<h3 class="card-title">{{communityInsights.mostCommented.address}}</h3>
					<p>💬 {{communityInsights.mostCommented.commentCount}} comments</p>
				</a>
				{{/if}}
			</div>
		</section>
	{{/if}}


	<script src="/public/js/dashboard_notif_badge.js" defer></script>
</main>
