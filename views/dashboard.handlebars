<main class="page">
	<div class="dashboard-header">
		<h1>Dashboard</h1>
		<p class="welcome-text">Welcome, <strong>{{user.firstName}} {{user.lastName}}</strong> ({{user.userRole}}).</p>
	</div>

	<div class="dashboard-search">
		<form action="/violations" method="GET" class="search-form">
			<input type="text" name="search" placeholder="Search violations by address, type, status..." required>
			<button type="submit" class="btn-search">Search</button>
		</form>
	</div>

	<div class="analytics-container">
		{{#if userScoreInfo}}
			<a href="/reviews" class="metric-card" style="background:#e0f2fe; border-color:#bae6fd; text-decoration:none;">
				<span class="metric-value" style="color:#0369a1;">
					{{#if userScoreInfo.score}}{{userScoreInfo.score}}⭐{{else}}N/A{{/if}}
				</span>
				<span class="metric-label" style="text-transform: capitalize;">Avg {{user.userRole}} Rating ({{userScoreInfo.count}} reviews)</span>
			</a>
		{{/if}}
		<a href="/violations?minDays=16&days=30" class="metric-card">
			<span class="metric-value">{{violations30Days}}</span>
			<span class="metric-label">Due in 16–30 Days</span>
		</a>
		<a href="/violations?minDays=8&days=15" class="metric-card">
			<span class="metric-value metric-warning">{{violations15Days}}</span>
			<span class="metric-label">Due in 8–15 Days</span>
		</a>
		<a href="/violations?days=7" class="metric-card">
			<span class="metric-value metric-danger">{{violations7Days}}</span>
			<span class="metric-label">Due in ≤ 7 Days (Critical)</span>
		</a>
	</div>
	
	<p class="dashboard-subtitle">Manage your account and explore tools below.</p>

	<div class="dashboard-grid">
		<a href="/properties" class="dashboard-tile">
			<span class="tile-icon">🏢</span>
			<span class="tile-text">Properties</span>
		</a>
		<a href="/violations" class="dashboard-tile">
			<span class="tile-icon">⚠️</span>
			<span class="tile-text">Violations</span>
		</a>
		<a href="/evidence" class="dashboard-tile">
			<span class="tile-icon">📁</span>
			<span class="tile-text">Evidence Vault</span>
		</a>
		<a href="/reviews" class="dashboard-tile">
			<span class="tile-icon">⭐</span>
			<span class="tile-text">Reviews</span>
		</a>
		<a href="/comments" class="dashboard-tile">
			<span class="tile-icon">💬</span>
			<span class="tile-text">Comments</span>
		</a>
		<a href="/notifications" class="dashboard-tile">
			<span class="tile-icon">🔔</span>
			<span class="tile-text">Notifications</span>
		</a>
		<a href="/disputes" class="dashboard-tile">
			<span class="tile-icon">⚖️</span>
			<span class="tile-text">Disputes</span>
		</a>
		<a href="/attorneys" class="dashboard-tile">
			<span class="tile-icon">👔</span>
			<span class="tile-text">Attorneys</span>
		</a>
		{{#if isAdmin}}
			<a href="/admin" class="dashboard-tile admin-tile">
				<span class="tile-icon">⚙️</span>
				<span class="tile-text">Admin Controls</span>
			</a>
		{{/if}}
	</div>
</main>
